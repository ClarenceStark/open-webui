FROM python:3.12-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

ARG TARGETARCH

RUN printf 'APT::Acquire::Retries "5";\nAPT::Acquire::http::Timeout "30";\nAPT::Acquire::https::Timeout "30";\nAPT::Sandbox::User "root";\n' > /etc/apt/apt.conf.d/99sandboxroot

RUN apt-get update && apt-get install -y --no-install-recommends --fix-missing \
    bash \
    patch \
    tini \
    ca-certificates \
    curl \
    git \
    jq \
    xz-utils \
    unzip \
    zip \
    ripgrep \
    poppler-utils \
    procps \
    && rm -rf /var/lib/apt/lists/*

RUN apt-get update && apt-get install -y --no-install-recommends --fix-missing \
    libreoffice-core-nogui \
    libreoffice-impress-nogui \
    fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/*

RUN apt-get update && apt-get install -y --no-install-recommends --fix-missing \
    libatk1.0-0t64 \
    libatk-bridge2.0-0t64 \
    libxkbcommon0 \
    libatspi2.0-0t64 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libcups2t64 \
    libgbm1 \
    libpango-1.0-0 \
    libasound2t64 \
    && rm -rf /var/lib/apt/lists/*

RUN set -eux; \
    case "${TARGETARCH}" in \
      amd64) node_arch='x64' ;; \
      arm64) node_arch='arm64' ;; \
      *) echo "Unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    node_version='20.19.2'; \
    curl -fsSL "https://nodejs.org/dist/v${node_version}/node-v${node_version}-linux-${node_arch}.tar.xz" -o /tmp/node.tar.xz; \
    tar -xJf /tmp/node.tar.xz -C /opt; \
    ln -sf "/opt/node-v${node_version}-linux-${node_arch}/bin/node" /usr/local/bin/node; \
    ln -sf "/opt/node-v${node_version}-linux-${node_arch}/bin/npm" /usr/local/bin/npm; \
    ln -sf "/opt/node-v${node_version}-linux-${node_arch}/bin/npx" /usr/local/bin/npx; \
    ln -sf "/opt/node-v${node_version}-linux-${node_arch}/bin/corepack" /usr/local/bin/corepack; \
    mkdir -p /usr/local/lib; \
    ln -sfn "/opt/node-v${node_version}-linux-${node_arch}/lib/node_modules" /usr/local/lib/node_modules; \
    rm -f /tmp/node.tar.xz

ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
ENV NODE_PATH=/usr/local/lib/node_modules

RUN npm install -g \
    pptxgenjs \
    playwright \
    sharp \
    react \
    react-dom \
    react-icons \
    && npx playwright install chromium \
    && npm cache clean --force

ARG UID=10001
ARG GID=10001

RUN groupadd --gid "${GID}" sandbox \
    && useradd --uid "${UID}" --gid "${GID}" --create-home --shell /bin/bash sandbox

RUN python -m venv /opt/venvs/default \
    && /opt/venvs/default/bin/pip install --no-cache-dir --upgrade pip setuptools wheel \
    && /opt/venvs/default/bin/pip install --no-cache-dir \
        fastapi \
        "uvicorn[standard]" \
        pydantic \
        python-multipart \
        pillow \
        python-docx \
        python-pptx \
        defusedxml \
        matplotlib \
        pandas \
        pypandoc

RUN python -m venv /opt/venvs/data \
    && /opt/venvs/data/bin/pip install --no-cache-dir --upgrade pip setuptools wheel \
    && /opt/venvs/data/bin/pip install --no-cache-dir \
        numpy \
        pandas \
        openpyxl \
        xlsxwriter \
        matplotlib \
        seaborn \
        scikit-learn \
        scipy

WORKDIR /app
COPY sandbox_worker/app.py /app/sandbox_worker/app.py

ENV PATH=/opt/venvs/default/bin:/opt/node-v20.19.2-linux-${TARGETARCH}/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    VIRTUAL_ENV=/opt/venvs/default

USER sandbox
EXPOSE 8765

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["python", "-m", "uvicorn", "sandbox_worker.app:app", "--host", "0.0.0.0", "--port", "8765"]
